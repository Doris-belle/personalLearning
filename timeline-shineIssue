        </div>
      </div>
      <div class="update-time">{{ `「最近更新日期 ${s.strConfigLatestTime}」` }}</div>
    </div>
    <div class="content">
      <!-- 业务时间轴 -->
      <div class="timeline-container business-timeline">
        <div class="timeline-header">
          <div class="timeline-title">业务</div>
        </div>
        <div class="timeline-scroll-container" v-if="timelineData.business.length">
          <div class="swiper-button-prev" @click="handlePrev('business')" v-if="timelineData.business.length > 6" :class="{ disabled: isPrevDisabled('business') }"></div>
          <div class="timeline-scroll-content" ref="scrollContainerBusiness" @scroll="handleScroll('business')">
            <swiper
              :modules="modules"
              :slides-per-view="'auto'"
              :space-between="0"
              :allow-touch-move="true"
              :scrollbar="{ draggable: true }"
              :grabCursor="true"
              @swiper="(swiper) => onSwiper(swiper, 'business')"
            >
              <swiper-slide v-for="(item, index) in timelineData.business" :key="item.time">
                <div class="timeline-item" @mouseenter="showTooltip(item, index, $event)" @mouseleave="hideTooltip">
                  <a-timeline>
                    <a-timeline-item>
                      <template #dot>
                        <div class="timeline-dot custom-dot"></div>
                      </template>
                      <div class="timeline-content" :class="{ 'content-bottom': index % 2 === 1, 'content-top': index % 2 === 0 }">
