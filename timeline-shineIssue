              :space-between="0"
              :allow-touch-move="true"
              :scrollbar="{ draggable: true }"
              :grabCursor="true"
              @swiper="(swiper) => onSwiper(swiper, 'algorithm')"
            >
              <swiper-slide v-for="(item, index) in timelineData.algorithm" :key="item.time">
                <div class="doris">
                    <div ref="tooltipRef" class="tooltip-trigger" @mouseenter="showTooltip(item, index, $event)" @mouseleave="hideTooltip">
                      <div class="timeline-item">
