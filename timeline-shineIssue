<script setup lang="ts">
  import { ref, onMounted, computed, onBeforeUnmount } from 'vue';
  import { Timeline, Tooltip } from 'ant-design-vue';
  import { Swiper, SwiperSlide } from 'swiper/vue';
  import { Navigation, Pagination, Autoplay, A11y, Scrollbar } from 'swiper';
  import { useStrStore } from '/@/store/modules/str';
  import 'swiper/css';
  import nodata from '../assets/nodata.svg';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';
  import 'swiper/css/autoplay';

  // 注册组件
  const ATimeline = Timeline;
  const ATimelineItem = Timeline.Item;
  const ATooltip = Tooltip;
  const tooltipVisible = ref(false);
  const hoverindex = ref(1);
  const tooltipContent = ref('');
  const tooltipRef = ref(null);
  const tooltipDate = ref('');
  const tooltipVersion = ref('');
  let tooltipTimeout = null; // 定义一个定时器
  const currentTooltipIndex = ref(1);

  const s = useStrStore();

  // 移除 mock 数据，使用 computed 监听 store 中的数据
  const timelineData = computed(() => {
    if (!s.strConfigTimelineData) return { business: [], algorithm: [] };
    return {
      business:
        s.strConfigTimelineData.business?.map((item) => ({
          time: item.time,
          des: item.des,
        })) || [],
      algorithm:
        s.strConfigTimelineData.algorithm?.map((item) => ({
          time: item.time,
          des: item.des,
          version: item.version,
        })) || [],
    };
  });

  const showTooltip = (item, index, event) => {
    clearTimeout(tooltipTimeout); // 清除之前的定时器
    currentTooltipIndex.value = index;
    hoverindex.value = index;
    console.log(hoverindex.value, '======',index)
    tooltipTimeout = setTimeout(() => {
      tooltipVisible.value = true;
      tooltipContent.value = item.des;
      tooltipDate.value = item.time;
      tooltipVersion.value = item.version;

      const rect = event.target.getBoundingClientRect();

      tooltipRef.value.style.position = 'absolute';
      // tooltipRef.value.style.width = '100%';
      // tooltipRef.value.style.height = '100%';
      const jeecgSideBar = document.querySelector('.jeecg-layout-sideBar');
      const scrollY = window.scrollY;
      if (jeecgSideBar) {
        // const sideBarWidth = parseInt(jeecgSideBar.style.maxWidth, 10);
        // tooltipRef.value.style.left = `${rect.left - sideBarWidth}px`;
        // tooltipRef.value.style.top = `${rect.top - 112 + scrollY}px`;

      } else {
        // tooltipRef.value.style.left = `${rect.left - 10}px`;
        // tooltipRef.value.style.top = `${rect.top - 96 + scrollY}px`;
      }
    }, 600); // 设置延迟时间
  };

  const hideTooltip = () => {
    clearTimeout(tooltipTimeout); // 清除定时器
    tooltipVisible.value = false;
    hoverindex.value = -1;
  };

  // 存储两个 swiper 实例
  const swiperInstances = ref({
    business: { isEnd: false },
    algorithm: { isEnd: false },
  });

  const onSwiper = (swiper, type: 'business' | 'algorithm') => {
    swiperInstances.value[type] = swiper;
  };

  const handlePrev = (type: 'business' | 'algorithm') => {
    if (swiperInstances.value[type]) {
      swiperInstances.value[type].slidePrev();
    }
  };

  const handleNext = (type: 'business' | 'algorithm') => {
    if (swiperInstances.value[type]) {
      swiperInstances.value[type].slideNext();
    }
  };

  // Expose needed variables and methods to template
  const modules = [Navigation, Pagination, Autoplay, A11y, Scrollbar];

  const isPrevDisabled = (type: 'business' | 'algorithm') => {
    return swiperInstances.value[type]?.isBeginning;
  };

  const scrollContainerBusiness = ref(null);
  const scrollContainerAlgorithm = ref(null);

  const handleScroll = (type: 'business' | 'algorithm') => {
    const container = type === 'business' ? scrollContainerBusiness.value : scrollContainerAlgorithm.value;
    const scrollLeft = container.scrollLeft;
    const containerWidth = container.clientWidth;
    const scrollWidth = container.scrollWidth;

    // // 计算滚动条在容器内的百分比位置
    // const positionInContainer = (scrollLeft / (scrollWidth - containerWidth)) * 100;

    // 检查是否到达容器的右边
    if (scrollLeft + containerWidth >= scrollWidth) {
      swiperInstances.value[type].isEnd = true; // 设置 isEnd 为 true
    } else {
      swiperInstances.value[type].isEnd = false; // 重置 isEnd
    }
    if (scrollLeft === 0) {
      swiperInstances.value[type].isBeginning = true; // 设置 isBeginning 为 true
    } else {
      swiperInstances.value[type].isBeginning = false; // 重置 isBeginning
    }
  };

  onMounted(async () => {});

  // 组件卸载时
  onBeforeUnmount(() => {
    // ��里可以添加清理逻辑
  });

  // 计算按钮是否禁用
  const isNextDisabled = (type: 'business' | 'algorithm') => {
    return swiperInstances.value[type]?.isEnd;
  };
</script>

